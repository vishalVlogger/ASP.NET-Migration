@model IReadOnlyCollection<MigrationJobListItem>
@{
    ViewData["Title"] = "Migration dashboard";
    var hasRunning = Model.Any(job => job.State == "running");
}

<section class="dashboard-shell">
    <div class="dashboard-heading">
        <div>
            <span class="eyebrow">Persistent migration queue</span>
            <h1>Migration dashboard</h1>
            <p>Every completed batch is checkpointed. Resume after an API timeout or application restart without starting the project again.</p>
        </div>
        <a asp-action="Index" class="download-button">New migration →</a>
    </div>

    @if (TempData["Notice"] is string notice)
    {
        <div class="dashboard-message success">@notice</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="dashboard-message error">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-dashboard">
            <h2>No saved migrations yet</h2>
            <p>Upload a Web Forms project to create your first resumable migration.</p>
            <a asp-action="Index">Start a migration →</a>
        </div>
    }
    else
    {
        <div class="job-list">
            @foreach (var job in Model)
            {
                var canResume = job.State is "failed" or "interrupted" or "cancelled" or "needs-review";
                var stateLabel = job.State == "complete" ? "ready" : job.State == "needs-review" ? "review required" : job.State;
                <article class="job-card state-@job.State">
                    <div class="job-main">
                        <div class="job-title-row">
                            <div>
                                <span class="job-state">@stateLabel</span>
                                <h2>@job.ProjectName</h2>
                            </div>
                            <time datetime="@job.UpdatedAtUtc.ToString("O")">Updated @job.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</time>
                        </div>
                        <p class="job-stage">@job.Stage</p>
                        <div class="job-progress" aria-label="@job.Percent percent complete">
                            <span style="width:@job.Percent%"></span>
                        </div>
                        <div class="job-metrics">
                            <span><b>@job.Percent%</b> complete</span>
                            <span><b>@job.CompletedBatches</b> AI batches</span>
                            <span><b>@job.FallbackBatches</b> local fallbacks</span>
                            <span><b>@job.CheckpointedBatches/@job.TotalBatches</b> checkpointed</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(job.Error))
                        {
                            <p class="job-error">@job.Error</p>
                        }
                    </div>
                    <div class="job-actions">
                        @if (job.ResultId is not null)
                        {
                            <a asp-action="Result" asp-route-id="@job.ResultId">Review checkpoint</a>
                            <a asp-action="Download" asp-route-id="@job.ResultId">Download ZIP</a>
                        }
                        @if (canResume)
                        {
                            <form asp-action="ResumeJob" method="post">
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit" class="action-primary">Resume with AI</button>
                            </form>
                            <form asp-action="ContinueLocally" method="post">
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit">Continue locally</button>
                            </form>
                        }
                        @if (job.State == "needs-review" && job.ResultId is not null)
                        {
                            <form asp-action="RepairJob" method="post">
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit" class="action-primary">Repair &amp; rebuild</button>
                            </form>
                        }
                        @if (job.State == "running")
                        {
                            <form asp-action="CancelJob" method="post">
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit">Cancel &amp; preserve</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="DeleteJob" method="post" onsubmit="return confirm('Delete this migration and its saved files?');">
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit" class="danger-action">Delete</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    @if (hasRunning)
    {
        <script>window.setTimeout(() => window.location.reload(), 5000);</script>
    }
}

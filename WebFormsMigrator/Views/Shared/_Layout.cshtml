@using WebFormsMigrator.Services
@inject ICurrentTenant CurrentTenant
@inject ISubscriptionProvider Subscriptions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Reframe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />
</head>
<body>
    @{ var controller = ViewContext.RouteData.Values["controller"]?.ToString(); var subscription = Subscriptions.GetCurrent(); var settingsActive = controller is "AiSettings" or "Commercial" or "SystemSettings"; }
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <a asp-controller="Overview" asp-action="Index" class="brand"><span>{</span> reframe <span>}</span></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span><span></span><b class="sr-only">Open navigation</b></button>
        <nav id="primary-navigation" class="header-right" aria-label="Primary navigation">
            <a asp-controller="Overview" asp-action="Index" class="@(controller == "Overview" ? "active" : null)" aria-current="@(controller == "Overview" ? "page" : null)">Overview</a>
            <a asp-controller="Workspaces" asp-action="Index" class="@(controller is "Workspaces" or "Projects" ? "active" : null)" aria-current="@(controller is "Workspaces" or "Projects" ? "page" : null)">Workspaces</a>
            <a asp-controller="Home" asp-action="Dashboard" class="@(controller == "Home" ? "active" : null)" aria-current="@(controller == "Home" ? "page" : null)">Migration queue</a>
            <details class="settings-menu">
                <summary class="@(settingsActive ? "active" : null)">Settings</summary>
                <div><a asp-controller="AiSettings" asp-action="Index">AI providers</a><a asp-controller="Commercial" asp-action="Index">Plan &amp; usage</a><a asp-controller="SystemSettings" asp-action="Index">Security &amp; storage</a><span>@CurrentTenant.TenantId · @subscription.Plan</span>@if (User.Identity?.IsAuthenticated == true) { <form asp-controller="Access" asp-action="Logout" method="post"><button type="submit">Sign out</button></form> }</div>
            </details>
            <a asp-controller="Projects" asp-action="Create" class="header-cta">New project</a>
        </nav>
    </header>
    @if (TempData["Notice"] is string globalNotice) { <div class="global-toast success" role="status"><span>@globalNotice</span><button type="button" aria-label="Dismiss notification">×</button></div> }
    @if (TempData["Error"] is string globalError) { <div class="global-toast error" role="alert"><span>@globalError</span><button type="button" aria-label="Dismiss notification">×</button></div> }
    <main id="main-content">@RenderBody()</main>
    <footer><span>Built for deliberate migrations.</span><span>Review generated code before production use.</span></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

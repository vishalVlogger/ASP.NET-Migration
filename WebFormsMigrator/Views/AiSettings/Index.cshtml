@model AiSetupViewModel
@{ ViewData["Title"] = "AI providers"; }
<section class="dashboard-shell portfolio-shell settings-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-controller="Overview" asp-action="Index">Overview</a><span>/</span><b>AI providers</b></nav>
    <div class="dashboard-heading"><div><span class="eyebrow">Privacy and inference</span><h1>Choose how AI runs</h1><p>Deterministic assessment, compilation, and local structural migration remain available in every mode.</p></div></div>
    <div class="provider-choice-grid">
        <article class="provider-card @(!Model.CloudConfigured && !Model.LocalEnabled ? "selected" : null)"><span class="provider-kicker">Always available</span><h2>No AI</h2><p>Keep all source local and generate a deterministic structural migration with explicit review markers.</p><ul><li>No provider account</li><li>No inference cost</li><li>Maximum manual review</li></ul></article>
        <article class="provider-card @(Model.LocalEnabled ? "selected" : null)"><span class="provider-kicker">Recommended for privacy</span><h2>Private local AI</h2><p>Use a downloadable model through a loopback OpenAI-compatible runtime.</p><dl><div><dt>Model</dt><dd>@Model.LocalModel</dd></div><div><dt>Endpoint</dt><dd><code>@Model.LocalEndpoint</code></dd></div></dl><form asp-action="TestLocal" method="post"><button class="secondary-button" type="submit">Test local runtime</button></form>@if(Model.Health is not null){<p class="provider-health @(Model.Health.Ready ? "healthy" : "unhealthy")" role="status">@(Model.Health.Ready ? "Connected" : "Unavailable") · @Model.Health.Message</p>}</article>
        <article class="provider-card @(Model.CloudConfigured ? "selected" : null)"><span class="provider-kicker">Best model quality</span><h2>Managed cloud AI</h2><p>Use OpenAI, Gemini, or OpenRouter for semantic conversion and compiler repair.</p><ul><li>Selected: @Model.SelectedProvider</li><li>Usage and cost recorded</li><li>Provider credentials stay server-side</li></ul><span class="configuration-state">@(Model.CloudConfigured ? "Configured" : "Not configured")</span></article>
    </div>
    <section class="panel setup-checklist"><div><span class="eyebrow">Setup checklist</span><h2>Private local AI</h2></div><ol><li><b>Install a runtime</b><span>Use an OpenAI-compatible local server such as Ollama or LM Studio.</span></li><li><b>Download a coding model</b><span>Choose a model that fits the machine's RAM or GPU memory.</span></li><li><b>Configure the server</b><code>AI__Provider=LocalAI · LocalAI__Enabled=true</code></li><li><b>Test the connection</b><span>Reframe accepts plain HTTP only on a loopback endpoint.</span></li></ol></section>
    <section class="panel data-handling"><h2>Data handling</h2><div><b>Provider storage</b><span>OpenAI Responses requests set <code>store: false</code>.</span></div><div><b>Local accounting</b><span>Token counts, latency, cache hits, model, estimated cost, and success state are recorded.</span></div><div><b>Credentials</b><span>API keys are not stored in usage records or returned to the browser.</span></div></section>
</section>

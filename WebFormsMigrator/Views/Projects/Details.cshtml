@model ProjectDashboardViewModel
@using System.Globalization
@{ ViewData["Title"] = Model.Project.Name; var latest=Model.LatestAssessment; var reports=Model.Assessments.OrderBy(a=>a.CreatedAtUtc).ToList(); var points=reports.Count<2?"":string.Join(" ",reports.Select((a,i)=>$"{i*100d/(reports.Count-1):0},{100-a.Report.ModernizationScore.Overall:0}")); }
<section class="dashboard-shell portfolio-shell"><nav class="breadcrumbs"><a asp-controller="Workspaces" asp-action="Details" asp-route-id="@Model.Project.WorkspaceId">Workspace</a><span>/</span><b>@Model.Project.Name</b></nav>
<div class="dashboard-heading"><div><span class="eyebrow">@Model.Project.SourceType project</span><h1>@Model.Project.Name</h1><p>@(string.IsNullOrWhiteSpace(Model.Project.Description)?"Persistent modernization project":Model.Project.Description)</p></div><div class="heading-actions">@if(Model.Project.SourceType=="GitHub"){<form asp-action="RefreshGitHub" asp-route-id="@Model.Project.Id" method="post"><button class="download-button">Re-import &amp; assess</button></form>}else{<form asp-action="Assess" asp-route-id="@Model.Project.Id" method="post"><button class="download-button">Run assessment</button></form>}@if(latest is not null){<form asp-action="Migrate" asp-route-id="@Model.Project.Id" method="post"><button>Run migration</button></form>}</div></div>
<nav class="project-actions"><a asp-action="Assessments" asp-route-projectId="@Model.Project.Id">Assessment history</a><a href="#migration-history">Migration history</a>@if(latest is not null){<a asp-action="Assessment" asp-route-projectId="@Model.Project.Id" asp-route-assessmentId="@latest.Id">Latest report</a>}<a asp-action="Settings" asp-route-id="@Model.Project.Id">Project settings</a></nav>
@if(TempData["Notice"] is string notice){<div class="dashboard-message success">@notice</div>}@if(TempData["Error"] is string error){<div class="dashboard-message error">@error</div>}@if(latest is not null){<div class="source-status @(latest.SourceChanged?"changed":"same")">@(latest.SourceChanged?"Source changed since previous assessment":"No source changes detected") <code>@latest.SourceFingerprint[..Math.Min(12,latest.SourceFingerprint.Length)]</code></div>}
@if(Model.Project.SourceType=="GitHub"){<div class="repository-strip"><span>Repository <b>@Model.Project.SourceOwner/@Model.Project.SourceRepositoryName</b></span><span>Branch <code>@Model.Project.SourceBranch</code></span><span>Commit <code>@(Model.Project.SourceCommitSha is null?"unknown":Model.Project.SourceCommitSha[..Math.Min(12,Model.Project.SourceCommitSha.Length)])</code></span><span>Fingerprint <code>@(Model.Project.SourceFingerprint is null?"not assessed":Model.Project.SourceFingerprint[..Math.Min(12,Model.Project.SourceFingerprint.Length)])</code></span><span>Imported @(Model.Project.ImportedAtUtc?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))</span></div>}
<div class="project-summary"><article><span>Modernization score</span><strong>@(latest?.Report.ModernizationScore.Overall.ToString()??"—")</strong></article><article><span>Automation potential</span><strong>@(latest is null?"—":$"{latest.Report.AutomationPercentage}%")</strong></article><article><span>Effort estimate</span><strong>@(latest is null?"—":$"{latest.Report.Effort.MinimumHours}–{latest.Report.Effort.MaximumHours}h")</strong></article><article><span>Risk level</span><strong>@(latest?.Report.ModernizationScore.Severity.ToString()??"Not assessed")</strong></article></div>
<div class="project-detail-grid"><article class="panel detail-panel"><h2>Project overview</h2><dl><div><dt>Framework</dt><dd>@Model.Project.DetectedFramework</dd></div><div><dt>Source</dt><dd>@Model.Project.SourceType</dd></div><div><dt>Last assessment</dt><dd>@(Model.Project.LastAssessmentAtUtc?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")??"Never")</dd></div><div><dt>Last migration</dt><dd>@(Model.Project.LastMigrationAtUtc?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")??"Never")</dd></div><div><dt>History</dt><dd>@Model.Assessments.Count assessments · @Model.MigrationRuns.Count migrations</dd></div></dl>@if(Model.Project.SourceType=="GitHub"){<h3>Repository</h3><p><a href="@Model.Project.SourceRepositoryUrl" rel="noreferrer">@Model.Project.SourceOwner/@Model.Project.SourceRepositoryName</a><br/>Branch <code>@Model.Project.SourceBranch</code><br/>Commit <code>@(Model.Project.SourceCommitSha?[..Math.Min(12,Model.Project.SourceCommitSha.Length)]??"unknown")</code></p>}</article>
<article class="panel detail-panel"><h2>Modernization trend</h2>@if(reports.Count>1){<svg class="trend-chart" viewBox="0 0 100 100" role="img" aria-label="Modernization score trend"><polyline points="@points" fill="none" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke"/></svg>}else{<div class="empty-mini">Run another assessment to show a trend.</div>}<ol class="trend-values">@foreach(var item in reports.TakeLast(5)){<li><time>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM")</time><b>@item.Report.ModernizationScore.Overall</b><span>@item.Report.AutomationPercentage% automated · @item.Report.HighRiskPercentage% high risk</span></li>}</ol></article></div>
<div class="project-detail-grid"><article class="panel detail-panel"><div class="section-heading"><h2>Outstanding risks</h2><a asp-action="Assessments" asp-route-projectId="@Model.Project.Id">Assessment history</a></div>@if(latest is null){<div class="empty-mini">No assessment yet.</div>}else{<ul class="risk-list">@foreach(var risk in latest.Report.Findings.Where(f=>f.Severity>=FindingSeverity.High).Take(8)){<li><span class="risk-badge @risk.Severity.ToString().ToLowerInvariant()">@risk.Severity</span><b>@risk.Title</b><small>@risk.Evidence.Count affected files</small></li>}</ul>}</article><article class="panel detail-panel"><h2>Recent activity</h2><ol class="activity-list">@foreach(var activity in Model.Activities){<li><i></i><div><b>@activity.Description</b><time>@activity.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</time></div></li>}</ol></article></div>
<article class="panel detail-panel"><div class="section-heading"><h2>Migration history</h2><a asp-controller="Home" asp-action="Dashboard">All migration jobs</a></div>@if(Model.MigrationRuns.Count==0){<div class="empty-mini">No migration has been started for this project.</div>}else{<div class="history-table"><div class="history-head"><span>Run</span><span>Date</span><span>Assessment</span><span>Mode</span><span>Build</span><span>Status</span></div>@foreach(var run in Model.MigrationRuns){<div><code>@run.Id[..8]</code><time>@run.StartedAtUtc.ToLocalTime().ToString("dd MMM yy")</time><span>@(run.AssessmentId is null?"—":run.AssessmentId[..8])</span><span>@run.AiMode</span><span>@run.BuildStatus</span><b>@run.Status</b></div>}</div>}</article>
<form asp-action="@(Model.Project.IsArchived?"Restore":"Archive")" asp-route-id="@Model.Project.Id" method="post" class="archive-zone" onsubmit="return confirm('@(Model.Project.IsArchived?"Restore":"Archive") this project? Its history will be retained.');"><button>@(Model.Project.IsArchived?"Restore project":"Archive project")</button><small>Assessment and migration history will be retained.</small></form></section>

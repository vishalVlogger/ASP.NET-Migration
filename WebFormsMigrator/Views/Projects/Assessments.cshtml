@model AssessmentHistoryViewModel
@{ ViewData["Title"] = "Assessment history"; }
<section class="dashboard-shell portfolio-shell"><nav class="breadcrumbs"><a asp-action="Details" asp-route-id="@Model.Project.Id">@Model.Project.Name</a><span>/</span><b>Assessments</b></nav><div class="dashboard-heading"><div><span class="eyebrow">Immutable history</span><h1>Assessment history</h1><p>Compare evidence-backed snapshots as the source changes.</p></div><form asp-action="Assess" asp-route-id="@Model.Project.Id" method="post"><button class="download-button">Run assessment</button></form></div>
@if(Model.Assessments.Count>=2){<form asp-action="Compare" asp-route-projectId="@Model.Project.Id" method="get" class="compare-picker"><label>Earlier<select name="left">@foreach(var item in Model.Assessments.OrderBy(a=>a.CreatedAtUtc)){<option value="@item.Id">@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @item.Report.ModernizationScore.Overall</option>}</select></label><label>Later<select name="right">@foreach(var item in Model.Assessments.OrderByDescending(a=>a.CreatedAtUtc)){<option value="@item.Id">@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @item.Report.ModernizationScore.Overall</option>}</select></label><button>Compare assessments →</button></form>}
<div class="history-table assessment-history"><div class="history-head"><span>Date</span><span>Score</span><span>Automation</span><span>Manual</span><span>High risk</span><span>Effort</span><span>Source</span><span>Actions</span></div>@foreach(var item in Model.Assessments){<div><time>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</time><b>@item.Report.ModernizationScore.Overall</b><span>@item.Report.AutomationPercentage%</span><span>@item.Report.ManualReviewPercentage%</span><span>@item.Report.HighRiskPercentage%</span><span>@item.Report.Effort.MinimumHours–@item.Report.Effort.MaximumHours h</span><span class="source-change @(item.SourceChanged?"changed":"same")">@(item.SourceChanged?"Changed":"No change")</span><span class="row-actions"><a asp-action="Assessment" asp-route-projectId="@Model.Project.Id" asp-route-assessmentId="@item.Id">View</a><a asp-action="DownloadAssessment" asp-route-projectId="@Model.Project.Id" asp-route-assessmentId="@item.Id">MD</a><a asp-action="DownloadAssessment" asp-route-projectId="@Model.Project.Id" asp-route-assessmentId="@item.Id" asp-route-format="json">JSON</a></span></div>}</div></section>

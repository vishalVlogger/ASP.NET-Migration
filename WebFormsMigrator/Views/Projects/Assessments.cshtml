@model AssessmentHistoryViewModel
@{ ViewData["Title"] = "Assessment history"; var latest = Model.Assessments.FirstOrDefault(); }
<section class="dashboard-shell portfolio-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Details" asp-route-id="@Model.Project.Id">@Model.Project.Name</a><span>/</span><b>Assessments</b></nav>
    <partial name="_ProjectNavigation" model="@(new ProjectNavigationViewModel { ProjectId = Model.Project.Id, ProjectName = Model.Project.Name, LatestAssessmentId = latest?.Id, Active = "assessments" })" />
    <div class="dashboard-heading"><div><span class="eyebrow">Immutable history</span><h1>Assessment history</h1><p>Compare evidence-backed snapshots as the source changes.</p></div><form asp-action="Assess" asp-route-id="@Model.Project.Id" method="post"><button class="download-button">Run assessment</button></form></div>
    @if (Model.Assessments.Count >= 2)
    {
        <form asp-action="Compare" asp-route-projectId="@Model.Project.Id" method="get" class="compare-picker"><label>Earlier<select name="left">@foreach(var item in Model.Assessments.OrderBy(a => a.CreatedAtUtc)){<option value="@item.Id">@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @item.Report.ModernizationScore.Overall</option>}</select></label><label>Later<select name="right">@foreach(var item in Model.Assessments.OrderByDescending(a => a.CreatedAtUtc)){<option value="@item.Id">@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @item.Report.ModernizationScore.Overall</option>}</select></label><button>Compare assessments →</button></form>
    }
    <div class="responsive-table" tabindex="0" role="region" aria-label="Assessment history" aria-describedby="assessment-table-help">
        <span id="assessment-table-help" class="sr-only">Scroll horizontally to see all assessment fields.</span>
        <table class="product-table"><thead><tr><th>Date</th><th>Score</th><th>Automation</th><th>Manual</th><th>High risk</th><th>Effort</th><th>Source</th><th>Actions</th></tr></thead><tbody>
        @foreach(var item in Model.Assessments){<tr><td><time>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</time></td><td><b>@item.Report.ModernizationScore.Overall</b></td><td>@item.Report.AutomationPercentage%</td><td>@item.Report.ManualReviewPercentage%</td><td>@item.Report.HighRiskPercentage%</td><td>@item.Report.Effort.MinimumHours–@item.Report.Effort.MaximumHours h</td><td><span class="source-change @(item.SourceChanged ? "changed" : "same")">@(item.SourceChanged ? "Changed" : "No change")</span></td><td class="row-actions"><a asp-action="Assessment" asp-route-projectId="@Model.Project.Id" asp-route-assessmentId="@item.Id">View</a><a asp-action="DownloadAssessment" asp-route-projectId="@Model.Project.Id" asp-route-assessmentId="@item.Id">MD</a><a asp-action="DownloadAssessment" asp-route-projectId="@Model.Project.Id" asp-route-assessmentId="@item.Id" asp-route-format="json">JSON</a></td></tr>}
        </tbody></table>
    </div>
</section>

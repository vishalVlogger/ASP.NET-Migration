@model ModernizationProject
@{ ViewData["Title"] = "Project settings"; }
<section class="dashboard-shell narrow-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a><span>/</span><b>Settings</b></nav>
    <partial name="_ProjectNavigation" model="@(new ProjectNavigationViewModel { ProjectId = Model.Id, ProjectName = Model.Name, Active = "settings" })" />
    <h1>Project settings</h1>
    <form method="post" class="panel product-form">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <label><span>Name</span><input name="name" value="@Model.Name" maxlength="100" /></label>
        <label><span>Description</span><textarea name="description" rows="4" maxlength="500">@Model.Description</textarea></label>
        <div class="config-note">Source type and repository identity are preserved for traceability.</div>
        <button class="primary-button">Save changes</button>
    </form>
</section>

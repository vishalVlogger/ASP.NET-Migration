@model CreateProjectViewModel
@{ ViewData["Title"] = "Create project"; }
<section class="dashboard-shell narrow-shell"><nav class="breadcrumbs"><a asp-controller="Workspaces" asp-action="Index">Workspaces</a><span>/</span><b>Create project</b></nav><div class="dashboard-heading"><div><span class="eyebrow">Project onboarding</span><h1>Create project</h1><p>Upload one project ZIP or import a public GitHub repository. Analysis works without AI.</p></div></div>
<form method="post" enctype="multipart/form-data" class="panel product-form"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field-row"><label asp-for="Name"><span>Project name</span><input asp-for="Name" /></label><label asp-for="WorkspaceId"><span>Workspace</span><select asp-for="WorkspaceId">@foreach(var workspace in Model.Workspaces){<option value="@workspace.Id">@workspace.Name</option>}</select></label></div><label asp-for="Description"><span>Description</span><textarea asp-for="Description" rows="3"></textarea></label><fieldset><legend>Source</legend><div class="source-choice"><label><input asp-for="SourceType" type="radio" value="Upload" checked="@(Model.SourceType == "Upload")" /> Upload ZIP</label><label><input asp-for="SourceType" type="radio" value="GitHub" checked="@(Model.SourceType == "GitHub")" /> Public GitHub repository</label></div><label asp-for="ProjectZip"><span>Project ZIP</span><input asp-for="ProjectZip" type="file" accept=".zip" /><small>25 MB compressed, 50 MB expanded, up to 500 accepted source files.</small></label><label asp-for="RepositoryUrl"><span>GitHub repository URL</span><input asp-for="RepositoryUrl" placeholder="https://github.com/owner/repository" /><small>Public github.com repositories only. OAuth and private repositories are not supported.</small></label><label asp-for="Branch"><span>Branch (optional)</span><input asp-for="Branch" placeholder="Default branch" /></label></fieldset><div class="field-row"><label asp-for="Strategy"><span>Migration strategy</span><select asp-for="Strategy"><option value="PreserveBehavior">Preserve Behavior</option><option value="BalancedModernization">Balanced Modernization</option><option value="AggressiveModernization">Aggressive Modernization</option></select></label><label asp-for="DataAccessStrategy"><span>Data strategy</span><select asp-for="DataAccessStrategy"><option value="AnalyseOnly">Analyse Only</option><option value="PreserveAdoNet">Preserve ADO.NET</option><option value="Dapper">Dapper</option><option value="EfCore">EF Core</option></select></label></div><button class="primary-button">Analyse project →</button></form></section>

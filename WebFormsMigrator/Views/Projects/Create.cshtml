@model CreateProjectViewModel
@{ ViewData["Title"] = "Create project"; }
<section class="dashboard-shell narrow-shell onboarding-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-controller="Workspaces" asp-action="Index">Workspaces</a><span>/</span><b>Create project</b></nav>
    <div class="dashboard-heading"><div><span class="eyebrow">Guided onboarding</span><h1>Create project</h1><p>Import the source first. Reframe will assess it before any migration or AI request begins.</p></div></div>
    <ol class="onboarding-steps" aria-label="Project onboarding steps"><li class="active"><b>1</b><span>Source</span></li><li><b>2</b><span>Project</span></li><li><b>3</b><span>Options</span></li><li><b>4</b><span>Assess</span></li></ol>
    <form method="post" enctype="multipart/form-data" class="product-form onboarding-form" data-onboarding-form>
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <section class="panel onboarding-section" aria-labelledby="source-heading">
            <div class="step-heading"><span>01</span><div><h2 id="source-heading">Choose source</h2><p>Nothing is sent to an AI provider during project import.</p></div></div>
            <div class="source-cards" role="radiogroup" aria-label="Source type">
                <label><input asp-for="SourceType" type="radio" value="Upload" /><span><b>Upload ZIP</b><small>Best for private projects and local exports.</small></span></label>
                <label><input asp-for="SourceType" type="radio" value="GitHub" /><span><b>Public GitHub</b><small>Import a public repository and record its commit.</small></span></label>
            </div>
            <div data-source-panel="Upload"><label asp-for="ProjectZip"><span>Project ZIP</span><input asp-for="ProjectZip" type="file" accept=".zip" /><small>Maximum 25 MB compressed, 50 MB expanded, and 500 accepted source files.</small></label></div>
            <div data-source-panel="GitHub"><label asp-for="RepositoryUrl"><span>Repository URL</span><input asp-for="RepositoryUrl" placeholder="https://github.com/owner/repository" /><small>Public github.com repositories only.</small></label><label asp-for="Branch"><span>Branch <em>optional</em></span><input asp-for="Branch" placeholder="Use default branch" /></label></div>
        </section>
        <section class="panel onboarding-section" aria-labelledby="identity-heading">
            <div class="step-heading"><span>02</span><div><h2 id="identity-heading">Name the project</h2><p>Choose where assessment and migration history should live.</p></div></div>
            <div class="field-row"><label asp-for="Name"><span>Project name</span><input asp-for="Name" autocomplete="off" /><span asp-validation-for="Name" class="validation"></span></label><label asp-for="WorkspaceId"><span>Workspace</span><select asp-for="WorkspaceId">@foreach(var workspace in Model.Workspaces){<option value="@workspace.Id">@workspace.Name</option>}</select></label></div>
            <label asp-for="Description"><span>Description <em>optional</em></span><textarea asp-for="Description" rows="3" placeholder="Application purpose, owner, or migration goal"></textarea></label>
        </section>
        <details class="panel advanced-options">
            <summary><span><b>03 · Migration options</b><small>Balanced defaults are recommended. Change these only when the target architecture is already decided.</small></span><em>Advanced</em></summary>
            <div class="field-row"><label asp-for="Strategy"><span>Migration strategy</span><select asp-for="Strategy"><option value="PreserveBehavior">Preserve behavior</option><option value="BalancedModernization">Balanced modernization</option><option value="AggressiveModernization">Aggressive modernization</option></select></label><label asp-for="DataAccessStrategy"><span>Data strategy</span><select asp-for="DataAccessStrategy"><option value="AnalyseOnly">Analyze only</option><option value="PreserveAdoNet">Preserve ADO.NET</option><option value="Dapper">Dapper candidate</option><option value="EfCore">EF Core candidate</option></select></label></div>
        </details>
        <div class="onboarding-submit"><div><b>Next: deterministic assessment</b><span>AI remains optional after you review the findings.</span></div><button class="primary-button" type="submit">Import and assess →</button></div>
    </form>
</section>

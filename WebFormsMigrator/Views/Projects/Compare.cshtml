@model AssessmentComparison
@{ ViewData["Title"] = "Assessment comparison"; }
<section class="dashboard-shell portfolio-shell"><nav class="breadcrumbs"><a asp-action="Details" asp-route-id="@Model.Left.ProjectId">Project</a><span>/</span><a asp-action="Assessments" asp-route-projectId="@Model.Left.ProjectId">Assessments</a><span>/</span><b>Compare</b></nav><div class="dashboard-heading"><div><span class="eyebrow">Deterministic comparison</span><h1>Assessment comparison</h1><p>@Model.Left.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") → @Model.Right.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div></div><div class="delta-grid">@foreach(var metric in Model.Metrics){<article><span>@metric.Key</span><strong>@metric.Value.Left → @metric.Value.Right</strong><em class="@(metric.Value.Delta>0?"positive":metric.Value.Delta<0?"negative":"neutral")">@(metric.Value.Delta>0?"+":"")@metric.Value.Delta</em></article>}</div>
@foreach(var group in new[]{(FindingChangeKind.Resolved,"Resolved issues"),(FindingChangeKind.New,"New issues"),(FindingChangeKind.Changed,"Changed issues"),(FindingChangeKind.Unchanged,"Remaining issues")}){var items=Model.Findings.Where(item=>item.Change==group.Item1).ToList();<section class="comparison-section"><h2>@group.Item2 <small>@items.Count</small></h2>@if(items.Count==0){<div class="empty-mini">None</div>}else{<div class="comparison-list">@foreach(var item in items){<div><span class="status-badge">@item.Category</span><b>@item.Title</b><code>@item.FilePath</code><strong>@item.LeftOccurrences → @item.RightOccurrences</strong></div>}</div>}</section>}</section>

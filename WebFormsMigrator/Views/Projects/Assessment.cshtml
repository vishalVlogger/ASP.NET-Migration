@model Assessment
@{ ViewData["Title"] = "Assessment details"; var report=Model.Report; }
<section class="dashboard-shell portfolio-shell"><nav class="breadcrumbs"><a asp-action="Details" asp-route-id="@Model.ProjectId">Project</a><span>/</span><a asp-action="Assessments" asp-route-projectId="@Model.ProjectId">Assessments</a><span>/</span><b>@Model.Id[..8]</b></nav><div class="dashboard-heading"><div><span class="eyebrow">Assessment @Model.Id[..8]</span><h1>@report.ProjectName</h1><p>@Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") · Engine @Model.AssessmentEngineVersion · @(Model.SourceChanged?"Source changed":"No source changes detected")</p></div><div class="report-actions"><a asp-action="DownloadAssessment" asp-route-projectId="@Model.ProjectId" asp-route-assessmentId="@Model.Id">Markdown</a><a asp-action="DownloadAssessment" asp-route-projectId="@Model.ProjectId" asp-route-assessmentId="@Model.Id" asp-route-format="json">JSON</a></div></div><div class="project-summary"><article><span>Score</span><strong>@report.ModernizationScore.Overall</strong></article><article><span>Automation</span><strong>@report.AutomationPercentage%</strong></article><article><span>Manual review</span><strong>@report.ManualReviewPercentage%</strong></article><article><span>High risk</span><strong>@report.HighRiskPercentage%</strong></article></div><div class="finding-list">@foreach(var finding in report.Findings){<details class="finding-card @finding.Severity.ToString().ToLowerInvariant()"><summary><span><b>@finding.Title</b><small>@finding.Category · @finding.Evidence.Count files</small></span><em>@finding.Severity</em></summary><div><p>@finding.Explanation</p><h4>Why it matters</h4><p>@finding.WhyItMatters</p><h4>Recommendation</h4><p>@finding.Recommendation</p><ul>@foreach(var evidence in finding.Evidence){<li><code>@evidence.FilePath</code> · @evidence.Occurrences</li>}</ul></div></details>}</div></section>

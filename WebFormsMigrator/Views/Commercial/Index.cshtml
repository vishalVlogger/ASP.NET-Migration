@using WebFormsMigrator.Services
@{ ViewData["Title"]="Plan & usage"; var subscription=(SubscriptionSnapshot)ViewBag.Subscription; var features=(List<FeatureEntitlement>)ViewBag.Features; var cost=(decimal)ViewBag.MonthCost; var workspaceCount=(int)ViewBag.WorkspaceCount; var projectCount=(int)ViewBag.ProjectCount; var workspaceLimit=features.Single(item=>item.Feature==ProductFeature.WorkspaceManagement).Limit; var projectLimit=features.Single(item=>item.Feature==ProductFeature.ProjectAnalysis).Limit; string Label(ProductFeature feature) => feature switch { ProductFeature.ProjectAnalysis => "Project assessments", ProductFeature.LocalMigration => "Deterministic local migration", ProductFeature.MigrationReport => "Technical reports", ProductFeature.AiMigration => "AI-assisted migration", ProductFeature.FileRegeneration => "File regeneration", ProductFeature.LargeProjectMigration => "Large-project batches", ProductFeature.TeamWorkspace => "Team workspaces", ProductFeature.GitHubImport => "Public GitHub import", ProductFeature.WorkspaceManagement => "Workspaces", ProductFeature.AssessmentHistory => "Assessment history", ProductFeature.AssessmentComparison => "Assessment comparison", ProductFeature.MigrationHistory => "Migration history", _ => feature.ToString() }; }
<section class="dashboard-shell portfolio-shell settings-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-controller="Overview" asp-action="Index">Overview</a><span>/</span><b>Plan &amp; usage</b></nav>
    <div class="dashboard-heading"><div><span class="eyebrow">Plan and limits</span><h1>@subscription.Plan</h1><p>@subscription.Status. Reframe currently reports and enforces configured entitlements; no payment provider is connected.</p></div></div>
    <div class="usage-hero"><div><span>Estimated AI cost this month</span><strong>$@cost.ToString("0.00")</strong><small>Configured estimates; provider invoices remain authoritative.</small></div><div><span>Projects used</span><strong>@projectCount / @(projectLimit?.ToString() ?? "∞")</strong><small>Across the current tenant</small></div><div><span>Workspaces used</span><strong>@workspaceCount / @(workspaceLimit?.ToString() ?? "∞")</strong><small>Active and archived</small></div><div><span>Plan status</span><strong>@subscription.Status</strong><small>@(subscription.RenewsAtUtc is null ? "No renewal is scheduled" : $"Renews {subscription.RenewsAtUtc:dd MMM yyyy}")</small></div></div>
    <section class="panel"><div class="section-heading"><div><span class="eyebrow">Included capabilities</span><h2>What this plan enables</h2></div></div><div class="entitlement-grid">@foreach(var feature in features){<div class="@(feature.Enabled ? "enabled" : "disabled")"><span aria-hidden="true">@(feature.Enabled ? "✓" : "—")</span><div><b>@Label(feature.Feature)</b><small>@(!feature.Enabled ? "Not included" : feature.Limit is int limit ? $"Limit: {limit}" : "Included")@(feature.Enabled && feature.RetentionDays is int days ? $" · {days}-day retention" : "")</small></div></div>}</div></section>
    <div class="commercial-note"><b>Billing integration boundary</b><p>Connect a payment processor to <code>ISubscriptionProvider</code> before selling subscriptions. Configuration is the source of truth in this build.</p></div>
</section>

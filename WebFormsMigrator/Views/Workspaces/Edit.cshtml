@model Workspace
@{ ViewData["Title"] = "Workspace settings"; }
<section class="dashboard-shell narrow-shell"><nav class="breadcrumbs"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a><span>/</span><b>Settings</b></nav><h1>Workspace settings</h1><form method="post" class="panel product-form"><label><span>Name</span><input name="name" value="@Model.Name" maxlength="80" /></label><label><span>Description</span><textarea name="description" rows="4" maxlength="500">@Model.Description</textarea></label><button class="primary-button">Save changes</button></form></section>

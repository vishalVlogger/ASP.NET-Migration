@model WorkspaceDetailsViewModel
@{ ViewData["Title"] = Model.Workspace.Name; }
<section class="dashboard-shell portfolio-shell"><nav class="breadcrumbs"><a asp-action="Index">Workspaces</a><span>/</span><b>@Model.Workspace.Name</b></nav>
<div class="dashboard-heading"><div><span class="eyebrow">Workspace</span><h1>@Model.Workspace.Name</h1><p>@(string.IsNullOrWhiteSpace(Model.Workspace.Description) ? "Organize and track legacy .NET modernization projects." : Model.Workspace.Description)</p></div><div class="heading-actions"><a asp-controller="Projects" asp-action="Create" asp-route-workspaceId="@Model.Workspace.Id" class="download-button">Create project →</a><a asp-action="Edit" asp-route-id="@Model.Workspace.Id">Settings</a></div></div>
@if (TempData["Notice"] is string notice) { <div class="dashboard-message success">@notice</div> } @if (TempData["Error"] is string error) { <div class="dashboard-message error">@error</div> }
<form method="get" class="project-filters"><input name="search" value="@Model.Query.Search" placeholder="Search projects…" /><select name="sourceType"><option value="">All sources</option><option selected="@(Model.Query.SourceType == "Upload")">Upload</option><option selected="@(Model.Query.SourceType == "GitHub")">GitHub</option></select><select name="risk"><option value="">All risks</option>@foreach(var risk in new[]{"Low","Medium","High","Critical"}){<option selected="@(Model.Query.Risk == risk)">@risk</option>}</select><select name="sort"><option value="updated">Recently updated</option><option value="name" selected="@(Model.Query.Sort == "name")">Name</option><option value="score" selected="@(Model.Query.Sort == "score")">Score</option><option value="risk" selected="@(Model.Query.Sort == "risk")">Risk</option></select><label class="inline-check"><input type="checkbox" name="archived" value="true" checked="@Model.Query.Archived" /> Archived</label><button>Apply</button></form>
@if (Model.Projects.Count == 0) { <div class="empty-dashboard"><h2>No projects match this view</h2><p>Create a project from a ZIP or public GitHub repository.</p><a asp-controller="Projects" asp-action="Create" asp-route-workspaceId="@Model.Workspace.Id">Create project →</a></div> }
<div class="portfolio-cards">@foreach(var project in Model.Projects){<article class="portfolio-card"><div><span class="status-badge">@project.SourceType</span>@if(project.IsArchived){<span class="risk-badge medium">Archived</span>}</div><h2><a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">@project.Name</a></h2><p>@(string.IsNullOrWhiteSpace(project.Description) ? project.DetectedFramework : project.Description)</p><small>@project.DetectedFramework · Updated @project.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</small><div class="card-actions"><a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">Open project</a></div></article>}</div>
@if (!Model.Workspace.IsArchived) { <form asp-action="Archive" asp-route-id="@Model.Workspace.Id" method="post" class="archive-zone" onsubmit="return confirm('Archive this workspace? Projects and history remain available.');"><button>Archive workspace</button><small>This does not delete projects or history.</small></form> }
</section>

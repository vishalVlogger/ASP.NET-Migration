@{ ViewData["Title"]="Sign in"; }
<section class="dashboard-shell narrow-shell"><div class="dashboard-heading"><div><span class="eyebrow">Protected installation</span><h1>Sign in to Reframe</h1><p>Use the administrator credentials configured for this installation.</p></div></div><form method="post" class="panel product-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><label><span>Username</span><input name="username" autocomplete="username" required/></label><label><span>Password</span><input name="password" type="password" autocomplete="current-password" required/></label><button class="primary-button">Sign in</button></form></section>
